# Порт на хосте для обычного docker compose
APP_PORT=8000

# Домен для HTTPS через Caddy (docker-compose.prod.yml)
DOMAIN=study.example.com

# --- Главный администратор и вход ---
# Логин главного администратора. Остальные аккаунты создаются в админке и хранятся в SQLite.
CHIEF_USERNAME=admin
# Приоритет у хеша. Формат: pbkdf2_sha256:<iterations>:<salt_hex>:<hash_hex>
# Сгенерировать хеш:
# python -c "import hashlib,os; s=os.urandom(16); h=hashlib.pbkdf2_hmac('sha256', b'ВАШ_ПАРОЛЬ', s, 260000); print('pbkdf2_sha256:260000:'+s.hex()+':'+h.hex())"
ADMIN_PASSWORD_HASH=
# Простой пароль главного администратора только для локальной разработки. Если задан хеш, он имеет приоритет.
ADMIN_PASSWORD=
# Время жизни сессии в секундах (по умолчанию 8 часов)
ADMIN_SESSION_TTL=28800
# Путь к SQLite-базе аккаунтов (по умолчанию data/study.db)
# STUDY_DB_PATH=data/study.db
# Для production за Caddy с HTTPS раскомментируйте:
# ADMIN_COOKIE_SECURE=1
# TRUST_PROXY=1

# --- Контрольная модель ---
# Доступ хранится только на сервере. Поддерживается OpenAI-совместимый API.
GUARD_BASE_URL=https://routerai.ru/api/v1
GUARD_MODEL=
GUARD_API_KEY=
GUARD_TIMEOUT=30

# --- Целевая модель ---
# Доступ к целевой модели задаётся в браузере в админ-диалоге и на сервере не сохраняется.
TARGET_TIMEOUT=180
